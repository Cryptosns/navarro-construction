# Copia este archivo como .env.local y reemplaza los valores con tus claves reales.
# En PowerShell: Copy-Item env.template .env.local

# ─── Supabase ───────────────────────────────────────────────
# Dashboard → tu proyecto → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OpenAI ─────────────────────────────────────────────────
# https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-proj-...

# OpenAI TTS premium (opcional — por defecto usa HD)
# OPENAI_TTS_MODEL=tts-1-hd
# OPENAI_TTS_VOICE_ES=echo
# OPENAI_TTS_VOICE_EN=echo
# OPENAI_TTS_SPEED=0.97

# ─── Notificaciones SMS (Twilio) ──────────────────────────────
# https://console.twilio.com → Account Info + Phone Numbers
# México: compra un número con capacidad SMS o usa trial (solo números verificados)

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ─── Notificaciones push (opcional) ─────────────────────────
# Genera las claves con: npx web-push generate-vapid-keys
# En Vercel: Settings → Environment Variables (Production + Preview)

NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto para el cron de recordatorios (Vercel lo envía automáticamente)
# Genera uno aleatorio: openssl rand -base64 32
CRON_SECRET=tu-secreto-aleatorio-largo
